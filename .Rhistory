# Machine Learning Forecasting and Optimization of Food Production in Ghana
# Data Cleaning: FAOSTAT Crop Production Data
# Load packages
library(tidyverse)
library(janitor)
getwd()
setwd("C:/Users/hp/Desktop/FOOD PRODUCTION PROJECT")
faostat_raw <- read_csv(
"data/raw/FAOSTAT_data_en_7-28-2026 (1).csv"
)
names(faostat_raw)
unique(faostat_raw$Element)
unique(faostat_raw$Item)
faostat_raw %>%
filter(Item %in% c(
"Beans, dry",
"Cassava, fresh",
"Maize (corn)",
"Rice",
"Yams"
)) %>%
count(Item)
crop_clean <- faostat_raw %>%
clean_names() %>%
filter(
area == "Ghana",
item %in% c(
"Beans, dry",
"Cassava, fresh",
"Maize (corn)",
"Rice",
"Yams"
),
element %in% c(
"Area harvested",
"Production",
"Yield"
)
) %>%
select(
year,
item,
element,
unit,
value
)
head(crop_clean)
crop_wide <- crop_clean %>%
pivot_wider(
names_from = element,
values_from = value
)
head(crop_wide)
crop_final <- crop_wide %>%
rename(
crop = item,
area_harvested = `Area harvested`,
production = Production,
yield = Yield
)
colSums(is.na(crop_final))
sted = `Area harvested`,
crop_final %>%
count(crop)
write_csv(
crop_final,
"data/processed/crop_production_clean.csv"
)
